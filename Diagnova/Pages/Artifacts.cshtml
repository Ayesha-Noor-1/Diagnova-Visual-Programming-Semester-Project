@page
@{
    Layout = null;
    ViewData["Title"] = "My Health Artifacts";
}
@model Diagnova.Pages.ArtifactsModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diagnova - Health Artifacts</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-green: #0f5c3b;
            --primary-green-light: #1a7a4c;
            --primary-green-soft: #e6f4ea;
            --text-dark: #1e2a32;
            --text-muted: #5a6e7a;
            --border-light: #e8edf0;
            --bg-gray: #f7f9fb;
            --bg-white: #ffffff;
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.06);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: transparent;
        }

        .artifacts-container {
            animation: fadeIn 0.3s ease;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .artifacts-header {
            margin-bottom: 2rem;
        }

        .artifacts-header h1 {
            font-size: 1.8rem;
            color: var(--text-dark);
            margin-bottom: 0.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .artifacts-header h1 i {
            color: var(--primary-green);
            font-size: 1.6rem;
        }

        .artifacts-header p {
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .artifacts-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }

        .artifact-card {
            background: var(--bg-white);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            transition: transform 0.2s, box-shadow 0.2s;
            border: 1px solid var(--border-light);
        }

        .artifact-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-md);
        }

        .card-header {
            background: var(--primary-green-soft);
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .card-header i {
            font-size: 1.2rem;
            color: var(--primary-green);
        }

        .card-header h3 {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-dark);
        }

        .card-body {
            padding: 1.5rem;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--border-light);
        }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-label {
            font-weight: 500;
            color: var(--text-muted);
            font-size: 0.8rem;
        }

        .info-value {
            color: var(--text-dark);
            font-size: 0.85rem;
            font-weight: 500;
        }

        .badge-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            justify-content: flex-end;
        }

        .badge {
            background: var(--primary-green-soft);
            color: var(--primary-green);
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 500;
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            background: var(--bg-white);
            border-radius: 20px;
        }

        .empty-state i {
            font-size: 3rem;
            color: var(--text-muted);
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        .empty-state h3 {
            color: var(--text-dark);
            margin-bottom: 0.5rem;
        }

        .empty-state p {
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

        .btn-primary {
            background: var(--primary-green);
            color: white;
            padding: 0.6rem 1.2rem;
            border-radius: 40px;
            text-decoration: none;
            display: inline-block;
            font-size: 0.85rem;
            font-weight: 500;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
        }

        .btn-primary:hover {
            background: var(--primary-green-light);
            transform: translateY(-2px);
        }

        @@media (max-width: 900px) {
            .artifacts-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

<div class="artifacts-container">
    @if (Model.UserProfile != null)
    {
        <div class="artifacts-header">
            <h1>
                <i class="fas fa-database"></i> 
                My Health Artifacts
            </h1>
            <p>Your complete health profile - securely stored and encrypted</p>
        </div>

        <div class="artifacts-grid">
            <!-- Personal Information Card -->
            <div class="artifact-card">
                <div class="card-header">
                    <i class="fas fa-user-circle"></i>
                    <h3>Personal Information</h3>
                </div>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">Full Name</span>
                        <span class="info-value">@Model.UserProfile.FullName</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Username</span>
                        <span class="info-value">@Model.UserProfile.Username</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Email</span>
                        <span class="info-value">@Model.UserProfile.Email</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Date of Birth</span>
                        <span class="info-value">@Model.UserProfile.DateOfBirth.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Age</span>
                        <span class="info-value">@Model.UserProfile.Age years</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Gender</span>
                        <span class="info-value">@Model.UserProfile.Gender</span>
                    </div>
                </div>
            </div>

            <!-- Physical Health Metrics Card -->
            <div class="artifact-card">
                <div class="card-header">
                    <i class="fas fa-heartbeat"></i>
                    <h3>Physical Health Metrics</h3>
                </div>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">Weight</span>
                        <span class="info-value">@Model.UserProfile.WeightKg kg</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Height</span>
                        <span class="info-value">@Model.UserProfile.HeightCm cm</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">BMI</span>
                        <span class="info-value">@Model.UserProfile.BMI</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Blood Type</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.UserProfile.BloodType) ? "Not specified" : Model.UserProfile.BloodType)</span>
                    </div>
                </div>
            </div>

            <!-- Medical Background Card -->
            <div class="artifact-card">
                <div class="card-header">
                    <i class="fas fa-notes-medical"></i>
                    <h3>Medical Background</h3>
                </div>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">Conditions</span>
                        <div class="badge-list">
                            @foreach (var condition in Model.UserProfile.PreExistingConditions)
                            {
                                <span class="badge">@condition</span>
                            }
                            @if (!Model.UserProfile.PreExistingConditions.Any())
                            {
                                <span class="info-value">None</span>
                            }
                        </div>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Allergies</span>
                        <div class="badge-list">
                            @foreach (var allergy in Model.UserProfile.Allergies)
                            {
                                <span class="badge">@allergy</span>
                            }
                            @if (!Model.UserProfile.Allergies.Any())
                            {
                                <span class="info-value">None</span>
                            }
                        </div>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Medications</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.UserProfile.CurrentMedications) ? "None" : Model.UserProfile.CurrentMedications)</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Smoking</span>
                        <span class="info-value">@Model.UserProfile.SmokingHabit</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Alcohol</span>
                        <span class="info-value">@Model.UserProfile.AlcoholHabit</span>
                    </div>
                </div>
            </div>

            <!-- Health Goals Card -->
            <div class="artifact-card">
                <div class="card-header">
                    <i class="fas fa-bullseye"></i>
                    <h3>Health Goals</h3>
                </div>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">Primary Goal</span>
                        <span class="info-value">@Model.UserProfile.PrimaryGoal</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Activity Level</span>
                        <span class="info-value">@Model.UserProfile.ActivityLevel</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Daily Calorie Target</span>
                        <span class="info-value">@(Model.UserProfile.DailyCalorieTarget?.ToString() ?? "Not set")</span>
                    </div>
                </div>
            </div>

            <!-- Emergency Contact Card -->
            <div class="artifact-card">
                <div class="card-header">
                    <i class="fas fa-shield-alt"></i>
                    <h3>Emergency Contact</h3>
                </div>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">Contact Name</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.UserProfile.EmergencyContactName) ? "Not set" : Model.UserProfile.EmergencyContactName)</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Contact Phone</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.UserProfile.EmergencyContactPhone) ? "Not set" : Model.UserProfile.EmergencyContactPhone)</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Country</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.UserProfile.CountryRegion) ? "Not set" : Model.UserProfile.CountryRegion)</span>
                    </div>
                </div>
            </div>

            <!-- Security Settings Card -->
            <div class="artifact-card">
                <div class="card-header">
                    <i class="fas fa-lock"></i>
                    <h3>Security Settings</h3>
                </div>
                <div class="card-body">
                    <div class="info-row">
                        <span class="info-label">Recovery Method</span>
                        <span class="info-value">@Model.UserProfile.RecoveryMethod</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.UserProfile.SecurityQuestion))
                    {
                        <div class="info-row">
                            <span class="info-label">Security Question</span>
                            <span class="info-value">@Model.UserProfile.SecurityQuestion</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-database"></i>
            <h3>No profile data found</h3>
            <p>Please complete your registration to see your health artifacts.</p>
            <a href="/Account/Register" class="btn-primary">Complete Registration</a>
        </div>
    }
</div>

</body>
</html>