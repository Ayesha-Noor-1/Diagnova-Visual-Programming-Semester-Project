@page
@model Diagnova.Pages.ChatModel
@{
    Layout = "_LayoutChat";
    ViewData["Title"] = "Symptom assistant";
    ViewData["BodyClass"] = "dn-chat-body-page";
}

<partial name="_ChatPartial" model="Model" />

@section Scripts {
    @if (Model.ShowEmergencyModal)
    {
        <script>document.documentElement.setAttribute('data-show-emergency', '1');</script>
    }
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
