@page
@model Diagnova.Pages.ChatModel
@{
   
    ViewData["Title"] = "Symptom assistant";
    ViewData["BodyClass"] = "dn-inner";
}

<div class="dn-chat-page pt-3 pt-md-4">
    <div class="dn-chat-toolbar">
        <a class="btn btn-sm dn-btn-outline-success rounded-pill px-3 d-inline-flex align-items-center gap-2" asp-page="/Dashboard"><partial name="_Icon" model='new IconModel { Id = "arrow-left", Size = 18, CssClass = "dn-icon flex-shrink-0" }' /> Back</a>
        <form method="post" asp-page-handler="NewChat" class="m-0">
            <button type="submit" class="btn btn-sm dn-btn-success rounded-pill px-3">New conversation</button>
        </form>
    </div>

    <p class="dn-chat-disclaimer mb-0">
        Disclaimer: AI responses are for informational purposes only. Consult healthcare professionals for medical advice.
    </p>

    <div class="dn-chat-shell mt-2 mb-0">
        @if (Model.Messages.Count == 0)
        {
            <div class="text-center text-muted py-5">
                <div class="dn-mascot dn-mascot-lg mx-auto mb-3" aria-hidden="true">
                    <partial name="_Icon" model='new IconModel { Id = "stethoscope", Size = 48, CssClass = "dn-icon dn-mascot-svg" }' />
                </div>
                <p class="mb-1 fw-semibold text-dark">Diagnova assistant</p>
                <p class="small mb-0">Describe how you feel — past chats are remembered for better context.</p>
            </div>
        }
        else
        {
            foreach (var line in Model.Messages)
            {
                var isUser = string.Equals(line.Role, "user", StringComparison.OrdinalIgnoreCase);
                <div class="dn-msg-row @(isUser ? "user" : "")">
                    @if (!isUser)
                    {
                        <div class="dn-avatar bot" aria-hidden="true">
                            <partial name="_Icon" model='new IconModel { Id = "assistant", Size = 18, CssClass = "dn-icon dn-avatar-svg" }' />
                        </div>
                    }
                    else
                    {
                        <div class="dn-avatar user" aria-hidden="true">
                            <partial name="_Icon" model='new IconModel { Id = "user", Size = 18, CssClass = "dn-icon dn-avatar-svg" }' />
                        </div>
                    }
                    <div class="dn-msg-bubble text-start">
                        <div class="dn-msg-meta">@(isUser ? "You" : "Diagnova")</div>
                        <div class="dn-chat-content">@line.Content</div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="dn-composer-wrap">
        <p class="dn-composer-hint text-center mb-2">
            Tip: mention duration and severity. <span class="text-success fw-semibold">Not a substitute for emergency care.</span>
        </p>
        <form method="post" id="chatForm">
            @Html.AntiForgeryToken()
            <div class="dn-composer">
                <span class="align-self-center ps-1 dn-composer-attach" aria-hidden="true" title="Attachments coming soon">
                    <partial name="_Icon" model='new IconModel { Id = "plus", Size = 22, CssClass = "dn-icon text-muted flex-shrink-0" }' />
                </span>
                <textarea asp-for="UserInput" id="UserInput" class="form-control flex-grow-1" rows="1" placeholder="Ask anything about your health…" autocomplete="off"></textarea>
                <div class="dn-composer-actions pe-1">
                    <button type="button" class="dn-mic-btn" disabled title="Voice input coming soon">
                        <partial name="_Icon" model='new IconModel { Id = "mic", Size = 22, CssClass = "dn-icon flex-shrink-0" }' />
                    </button>
                    <button type="submit" class="btn dn-btn-success dn-send-btn">
                        <partial name="_Icon" model='new IconModel { Id = "send", Size = 18, CssClass = "dn-icon flex-shrink-0" }' /> Send
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="emergencyModal" tabindex="-1" aria-labelledby="emergencyModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="emergencyModalTitle">You may be in an alarming situation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(Model.AlarmingReason))
                {
                    <p class="fw-semibold text-danger-emphasis mb-2">@Model.AlarmingReason</p>
                    <p class="small text-muted mb-3">Based on your message and saved profile. This is not a diagnosis — seek urgent in-person care.</p>
                }
                else
                {
                    <p class="fw-semibold mb-2">Call emergency services or go to the <strong>nearest emergency center</strong> if symptoms are severe.</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SpecialistHint))
                {
                    <p class="small mb-3"><strong>Related care type:</strong> @Model.SpecialistHint</p>
                }
                @if (Model.EmergencyKeywords.Count > 0)
                {
                    <p class="fw-semibold mb-2">Matched urgent phrases</p>
                    <ul class="mb-3">
                        @foreach (var k in Model.EmergencyKeywords)
                        {
                            <li>@k</li>
                        }
                    </ul>
                }
                <p class="mb-2"><strong>Pakistan (verify locally):</strong> 1122 · 115 (Edhi) · 1166</p>
                <hr class="my-3" />
                <p class="fw-semibold mb-2">Nearest emergency suggestions (map)</p>
                <p class="small text-muted mb-2">Share your approximate location. A second AI model suggests facilities with coordinates; <strong>always confirm by phone or official maps</strong> — listings can be wrong.</p>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-danger" id="emergencyShareLocationBtn">Use my location</button>
                    <span class="small text-muted align-self-center" id="emergencyGeoStatus"></span>
                </div>
                <div id="emergencyMap" class="rounded border dn-emergency-map mb-3" style="min-height: 280px; background: #e9ecef;"></div>
                <div id="emergencyFacilityList" class="small"></div>
            </div>
            <div class="modal-footer flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <a class="btn btn-outline-danger" asp-page="/Nearby">Nearby care page</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.ShowEmergencyModal)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var el = document.getElementById('emergencyModal');
                if (el && window.bootstrap) {
                    new bootstrap.Modal(el).show();
                }
            });
        </script>
    }
    <script>
        (function () {
            var ta = document.getElementById('UserInput');
            if (!ta) return;
            ta.addEventListener('input', function () {
                this.style.height = 'auto';
                this.style.height = Math.min(this.scrollHeight, 140) + 'px';
            });
        })();
    </script>
    <script>
        (function () {
            var btn = document.getElementById('emergencyShareLocationBtn');
            var statusEl = document.getElementById('emergencyGeoStatus');
            var mapEl = document.getElementById('emergencyMap');
            var listEl = document.getElementById('emergencyFacilityList');
            if (!btn || !mapEl || !listEl) return;

            var mapInstance = null;
            var layerGroup = null;

            function getAntiForgeryToken() {
                var input = document.querySelector('#chatForm input[name="__RequestVerificationToken"]');
                return input ? input.value : '';
            }

            function loadScript(src) {
                return new Promise(function (resolve, reject) {
                    var s = document.createElement('script');
                    s.src = src;
                    s.async = true;
                    s.onload = resolve;
                    s.onerror = function () {
                        reject(new Error('Could not load script: ' + src + ' (CDN blocked or offline).'));
                    };
                    document.head.appendChild(s);
                });
            }

            function loadLeaflet() {
                if (window.L) return Promise.resolve();
                var link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
                document.head.appendChild(link);
                return loadScript('https://unpkg.com/leaflet@1.9.4/dist/leaflet.js')
                    .then(function () {
                        if (!window.L) {
                            throw new Error('Map library did not initialize (Leaflet missing after load).');
                        }
                    });
            }

            function ensureMap(lat, lng) {
                return loadLeaflet().then(function () {
                    if (!mapInstance) {
                        mapInstance = L.map(mapEl).setView([lat, lng], 13);
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            maxZoom: 19,
                            attribution: '&copy; OpenStreetMap'
                        }).addTo(mapInstance);
                        layerGroup = L.featureGroup().addTo(mapInstance);
                    } else {
                        mapInstance.setView([lat, lng], 13);
                        layerGroup.clearLayers();
                    }
                });
            }

            function renderFacilities(data) {
                listEl.innerHTML = '';
                if (!data || !data.facilities || !data.facilities.length) {
                    listEl.innerHTML = '<p class="text-muted mb-0">No facilities returned. Call emergency services or search maps manually.</p>';
                    return;
                }
                var ul = document.createElement('ul');
                ul.className = 'list-unstyled mb-0';
                data.facilities.forEach(function (f) {
                    var li = document.createElement('li');
                    li.className = 'mb-2 border rounded p-2';
                    var dist = (typeof f.distanceKm === 'number' ? f.distanceKm : f.DistanceKm);
                    var name = f.name || f.Name;
                    var addr = f.address || f.Address;
                    var notes = f.notes || f.Notes;
                    li.innerHTML = '<strong>' + name + '</strong> · <span class="text-success fw-semibold">' + dist + ' km</span><br />'
                        + (addr ? '<span class="text-muted">' + addr + '</span><br />' : '')
                        + (notes ? '<span class="small">' + notes + '</span>' : '');
                    ul.appendChild(li);
                });
                listEl.appendChild(ul);
            }

            btn.addEventListener('click', function () {
                if (!navigator.geolocation) {
                    if (statusEl) statusEl.textContent = 'Geolocation is not supported in this browser.';
                    return;
                }
                if (statusEl) statusEl.textContent = 'Requesting location…';
                btn.disabled = true;
                navigator.geolocation.getCurrentPosition(
                    function (pos) {
                        var lat = pos.coords.latitude;
                        var lng = pos.coords.longitude;
                        var token = getAntiForgeryToken();
                        if (!token) {
                            if (statusEl) statusEl.textContent = 'Missing form security token — refresh the page, then try again.';
                            btn.disabled = false;
                            return;
                        }
                        var body = new URLSearchParams();
                        body.set('lat', String(lat));
                        body.set('lng', String(lng));
                        body.set('__RequestVerificationToken', token);

                        var postUrl = window.location.pathname + '?handler=EmergencyPlaces';
                        fetch(postUrl, {
                            method: 'POST',
                            credentials: 'same-origin',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': token
                            },
                            body: body.toString()
                        })
                            .then(function (r) {
                                return r.text().then(function (text) {
                                    var ct = (r.headers.get('content-type') || '').toLowerCase();
                                    if (!r.ok) {
                                        var hint = text && text.indexOf('antiforgery') >= 0
                                            ? ' (try refreshing the page and opening this popup again)'
                                            : '';
                                        throw new Error('Request failed (' + r.status + ')' + hint);
                                    }
                                    if (ct.indexOf('application/json') < 0) {
                                        throw new Error('Server did not return JSON (status ' + r.status + '). You may need to sign in again or refresh the page.');
                                    }
                                    try {
                                        return JSON.parse(text);
                                    } catch (e) {
                                        throw new Error('Invalid JSON from server.');
                                    }
                                });
                            })
                            .then(function (data) {
                                if (!data || !data.ok) {
                                    if (statusEl) statusEl.textContent = (data && data.error) ? data.error : 'Could not load suggestions.';
                                    btn.disabled = false;
                                    return;
                                }
                                if (statusEl) statusEl.textContent = 'Location received. Showing map…';
                                renderFacilities(data);
                                var pt = data.patient || data.Patient;
                                if (!pt || pt.lat == null || pt.lng == null) {
                                    throw new Error('Server response missing patient coordinates.');
                                }
                                var plat = pt.lat != null ? pt.lat : pt.Lat;
                                var plng = pt.lng != null ? pt.lng : pt.Lng;
                                return ensureMap(plat, plng).then(function () {
                                    var red = L.circleMarker([plat, plng], { radius: 9, color: '#b02a37', fillColor: '#dc3545', fillOpacity: 0.85 }).bindPopup('Your approximate location');
                                    red.addTo(layerGroup);
                                    (data.facilities || []).forEach(function (f) {
                                        var la = f.latitude != null ? f.latitude : f.Latitude;
                                        var lo = f.longitude != null ? f.longitude : f.Longitude;
                                        var nm = f.name || f.Name;
                                        if (la == null || lo == null) return;
                                        L.marker([la, lo]).addTo(layerGroup).bindPopup(nm);
                                    });
                                    var bounds = layerGroup.getBounds();
                                    if (bounds.isValid()) mapInstance.fitBounds(bounds.pad(0.2));
                                    setTimeout(function () { mapInstance.invalidateSize(); }, 200);
                                    if (statusEl) statusEl.textContent = '';
                                    btn.disabled = false;
                                });
                            })
                            .catch(function (err) {
                                var msg = (err && err.message) ? err.message : (typeof err === 'string' ? err : 'Something went wrong. Hard-refresh the page (Ctrl+F5) and try again.');
                                if (statusEl) statusEl.textContent = msg;
                                btn.disabled = false;
                            });
                    },
                    function () {
                        if (statusEl) statusEl.textContent = 'Location denied. Enable location or search maps manually.';
                        btn.disabled = false;
                    },
                    { enableHighAccuracy: false, timeout: 15000, maximumAge: 60000 }
                );
            });
        })();
    </script>
}
