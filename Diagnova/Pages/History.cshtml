@page
@model Diagnova.Pages.HistoryModel
@{
    ViewData["Title"] = "Patient history";
    ViewData["BodyClass"] = "dn-inner";
}

<div class="container py-4 py-md-5 dn-page-wide">
    <header class="mb-4 d-flex flex-column flex-md-row justify-content-between align-items-start gap-3">
        <div>
            <p class="dn-page-eyebrow mb-0">Your account</p>
            <h1 class="dn-page-title mb-2">Chat history</h1>
            <p class="dn-page-lead mb-0">All symptom assistant conversations. Select a card to continue.</p>
        </div>
        <a class="btn dn-btn-success rounded-pill px-4 fw-semibold flex-shrink-0" asp-page="/Chat">
            <partial name="_Icon" model='new IconModel { Id = "chat", Size = 18, CssClass = "dn-icon me-1" }' /> New chat
        </a>
    </header>

    @if (Model.Sessions.Count == 0)
    {
        <div class="dn-empty-state">
            <div class="dn-mascot mx-auto mb-3" style="width:4rem;height:4rem;margin-top:0;">
                <partial name="_Icon" model='new IconModel { Id = "clipboard", Size = 34, CssClass = "dn-icon text-success" }' />
            </div>
            <p class="fw-semibold text-dark mb-1">No sessions yet</p>
            <p class="small mb-3">Start a conversation in the symptom assistant — it will appear here.</p>
            <a class="btn dn-btn-success rounded-pill px-4" asp-page="/Chat">Start symptom chat</a>
        </div>
    }
    else
    {
        <div class="dn-history-grid">
            @foreach (var s in Model.Sessions)
            {
                <a class="dn-history-card" asp-page="/Chat" asp-route-sessionId="@s.Id">
                    <div class="dn-history-card-top">
                        <h2 class="dn-history-card-title">@s.Title</h2>
                        @if (s.ClosedAt.HasValue)
                        {
                            <span class="badge rounded-pill text-bg-secondary">Closed</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill text-bg-success">Active</span>
                        }
                    </div>
                    <p class="dn-history-card-date">
                        <partial name="_Icon" model='new IconModel { Id = "clock", Size = 14, CssClass = "dn-icon me-1" }' />
                        @s.StartedAt.LocalDateTime.ToString("MMMM d, yyyy · h:mm tt")
                    </p>
                    <p class="dn-history-card-meta mb-0">@s.MessageCount message@(s.MessageCount == 1 ? "" : "s")</p>
                </a>
            }
        </div>
    }
</div>
