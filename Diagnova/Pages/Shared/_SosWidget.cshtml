@* Floating one-tap SOS — authenticated users only *@
@if (User.Identity?.IsAuthenticated == true)
{
    <button type="button" class="dn-sos-fab" id="dnSosFab" aria-label="One-tap SOS emergency alert" title="One-tap SOS">
        <span class="dn-sos-fab-icon" aria-hidden="true">SOS</span>
    </button>

    <div class="modal fade" id="sosModal" tabindex="-1" aria-labelledby="sosModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content dn-sos-modal border-0 shadow-lg">
                <div class="modal-header dn-sos-modal-header">
                    <div>
                        <span class="badge bg-danger mb-2">Emergency</span>
                        <h5 class="modal-title text-white mb-0" id="sosModalTitle">One-tap SOS</h5>
                        <p class="small text-white-50 mb-0">Sends your GPS location and medical summary to emergency contacts.</p>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="sosStatus" class="dn-sos-status small text-muted mb-3">Press the red SOS button and confirm to alert your contacts.</div>
                    <div id="sosActions" class="d-flex flex-wrap gap-2 mb-3 d-none">
                        <a id="sosMapsLink" href="#" target="_blank" rel="noopener" class="btn btn-outline-danger btn-sm d-none">
                            <i class="fas fa-map-marker-alt"></i> Your location
                        </a>
                        <a id="sosSmsLink" href="#" class="btn btn-outline-secondary btn-sm d-none">
                            <i class="fas fa-sms"></i> Send SMS
                        </a>
                        <a href="tel:1122" class="btn btn-danger btn-sm">Call 1122</a>
                    </div>
                    <div class="dn-sos-layout row g-3">
                        <div class="col-md-6">
                            <p class="dn-emergency-panel-label mb-2">Your location &amp; nearby hospitals</p>
                            <div id="sosMap" class="dn-sos-map rounded-3"></div>
                        </div>
                        <div class="col-md-6">
                            <p class="dn-emergency-panel-label mb-2">Nearest emergency facilities</p>
                            <div id="sosFacilityList" class="dn-facility-list"></div>
                            <details class="mt-3" open>
                                <summary class="small text-muted">Medical profile sent with alert</summary>
                                <pre id="sosProfilePreview" class="dn-sos-profile-preview small mt-2 mb-0"></pre>
                            </details>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="~/js/sos.js" asp-append-version="true"></script>
}
