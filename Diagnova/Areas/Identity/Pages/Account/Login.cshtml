@page
@model Diagnova.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["BodyClass"] = "dn-auth";
}

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body.dn-auth {
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        background: linear-gradient(135deg, #e8f0ec 0%, #dce8e2 100%);
        min-height: 100vh;
    }

    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .login-card {
        max-width: 1100px;
        width: 100%;
        background: white;
        border-radius: 28px;
        display: flex;
        flex-wrap: wrap;
        overflow: hidden;
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Left Side - Login Form */
    .form-side {
        flex: 1.2;
        padding: 3rem;
        background: white;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #6c7e74;
        font-size: 0.85rem;
        text-decoration: none;
        margin-bottom: 2rem;
        transition: all 0.2s;
        font-weight: 500;
    }

        .back-link:hover {
            color: #1a5c3e;
            gap: 10px;
        }

    .welcome-badge {
        display: inline-block;
        padding: 0.3rem 1rem;
        background: rgba(26, 92, 62, 0.1);
        border-radius: 60px;
        font-size: 0.7rem;
        font-weight: 700;
        color: #1a5c3e;
        margin-bottom: 1rem;
        letter-spacing: 0.5px;
    }

    .form-side h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #1a3a2c;
        margin-bottom: 0.5rem;
        letter-spacing: -0.3px;
    }

    .form-subtitle {
        color: #7a8e82;
        font-size: 0.9rem;
        margin-bottom: 2rem;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #2d473a;
        margin-bottom: 0.5rem;
        display: block;
    }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9bb3a7;
            font-size: 0.9rem;
            z-index: 1;
            transition: color 0.2s;
        }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem 0.75rem 2.5rem;
        border: 1.5px solid #e0e8e3;
        border-radius: 12px;
        font-size: 0.9rem;
        transition: all 0.2s;
        background: #fefefe;
        font-family: inherit;
    }

        .form-control:hover {
            border-color: #b8d0c4;
        }

        .form-control:focus {
            outline: none;
            border-color: #1a5c3e;
            box-shadow: 0 0 0 3px rgba(26, 92, 62, 0.08);
            background: white;
        }

    .input-wrapper:focus-within i {
        color: #1a5c3e;
    }

    .checkbox-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 1.25rem 0;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.8rem;
        color: #5a7064;
        cursor: pointer;
    }

        .checkbox-label input {
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: #1a5c3e;
        }

    .forgot-link {
        font-size: 0.8rem;
        color: #6c7e74;
        text-decoration: none;
        transition: color 0.2s;
    }

        .forgot-link:hover {
            color: #1a5c3e;
        }

    .btn-login {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(135deg, #1a5c3e, #2d8b5a);
        color: white;
        border: none;
        border-radius: 40px;
        font-size: 0.9rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        margin-top: 0.5rem;
        box-shadow: 0 2px 8px rgba(26, 92, 62, 0.2);
    }

        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(26, 92, 62, 0.25);
        }

    .divider {
        margin: 1.5rem 0;
        text-align: center;
        position: relative;
    }

        .divider::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 100%;
            height: 1px;
            background: #e4ece7;
        }

        .divider span {
            background: white;
            padding: 0 1rem;
            font-size: 0.75rem;
            color: #9aaea2;
            position: relative;
        }

    .register-link {
        text-align: center;
    }

        .register-link a {
            color: #1a5c3e;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.2s;
        }

            .register-link a:hover {
                text-decoration: underline;
            }

    /* Right Side - Features Panel */
    .features-side {
        width: 380px;
        background: linear-gradient(165deg, #1a5c3e 0%, #1e6e45 100%);
        padding: 3rem;
        position: relative;
        display: flex;
        flex-direction: column;
    }

        .features-side::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" opacity="0.05"><circle cx="20" cy="20" r="8"/><circle cx="80" cy="30" r="12"/><circle cx="50" cy="70" r="10"/><circle cx="15" cy="85" r="6"/><circle cx="90" cy="75" r="9"/></svg>');
            background-repeat: repeat;
            pointer-events: none;
        }

    .quote-icon {
        font-size: 2.2rem;
        color: rgba(255, 255, 255, 0.2);
        margin-bottom: 1.5rem;
    }

    .features-side h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        margin-bottom: 0.75rem;
        line-height: 1.3;
        position: relative;
        z-index: 1;
    }

    .features-side p {
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.85rem;
        line-height: 1.5;
        margin-bottom: 2rem;
        position: relative;
        z-index: 1;
    }

    .feature-list {
        position: relative;
        z-index: 1;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 1rem;
        color: rgba(255, 255, 255, 0.85);
    }

        .feature-item i {
            width: 20px;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.6);
        }

        .feature-item span {
            font-size: 0.85rem;
        }

    /* Responsive */
    @@media (max-width: 900px) {
        .features-side {
            display: none;
        }
        
        .login-card {
            max-width: 500px;
        }
        
        .form-side {
            padding: 2rem;
        }
    }
</style>

<div class="login-container">
    <div class="login-card">
        <!-- Left Side - Login Form -->
        <div class="form-side">
            <a class="back-link" asp-area="" asp-page="/Index">
                <i class="fas fa-arrow-left"></i> Back to Diagnova
            </a>

            <div class="welcome-badge">
                <i class="fas fa-heartbeat me-1"></i> Secure Access
            </div>
            <h1>Welcome back</h1>
            <p class="form-subtitle">Sign in to continue your health journey</p>

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <form id="account" method="post">
                <div class="form-group">
                    <label asp-for="Input.Username" class="form-label">Username</label>
                    <div class="input-wrapper">
                        <i class="fas fa-user"></i>
                        <input asp-for="Input.Username" class="form-control" autocomplete="username" placeholder="Enter your username" />
                    </div>
                    <span asp-validation-for="Input.Username" class="text-danger small"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="checkbox-wrapper">
                    <label class="checkbox-label">
                        <input asp-for="Input.RememberMe" /> Remember me
                    </label>
                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fas fa-arrow-right-to-bracket me-2"></i> Sign In
                </button>
            </form>

            <div class="divider">
                <span>New to Diagnova?</span>
            </div>

            <div class="register-link">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                    <i class="fas fa-user-plus me-1"></i> Create your free account
                </a>
            </div>
        </div>

        <!-- Right Side - Features Panel -->
        <div class="features-side">
            <div class="quote-icon">
                <i class="fas fa-stethoscope"></i>
            </div>
            
            <h2>Your health companion</h2>
            <p>AI-powered guidance for symptoms, medications, and wellness tracking — all in one secure platform.</p>

            <div class="feature-list">
                <div class="feature-item">
                    <i class="fas fa-comment-medical"></i>
                    <span>AI Symptom Checker</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-capsules"></i>
                    <span>OpenFDA Medicine Database</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-chart-line"></i>
                    <span>Vitals & Health Tracking</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-shield-alt"></i>
                    <span>Privacy Protected</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}